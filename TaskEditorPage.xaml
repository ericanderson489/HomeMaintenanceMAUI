<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:HomeMaintenanceMAUI"
             x:Class="HomeMaintenanceMAUI.TaskEditorPage"
             Title="Add task" NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource WorkshopBackground}">
  <ScrollView>
    <Border Style="{StaticResource WorkshopCard}" Margin="20" Padding="24"
            MaximumWidthRequest="620" HorizontalOptions="Fill">
      <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto"
      RowSpacing="14"
      Padding="0,0,0,20">

        <!-- Row 0: Heading -->
        <Label x:Name="EditorHeading" 
           Text="ADD TASK"
           Style="{StaticResource WorkshopPageHeading}" 
           Grid.Row="0" />

        <!-- Row 1: Separator Line -->
        <BoxView Color="{StaticResource WorkshopMuted}" 
             HeightRequest="1"
             WidthRequest="140" 
             HorizontalOptions="Start" 
             Margin="0,0,0,8" 
             Grid.Row="1" />

        <!-- Row 2: Title Label -->
        <Label Text="Task title" 
           Style="{StaticResource WorkshopLabel}" 
           Grid.Row="2" />

        <!-- Row 3: Title Entry -->
        <Entry x:Name="TaskTitleEntry" 
           Placeholder="Task title"
           Style="{StaticResource WorkshopEntry}" 
           SemanticProperties.Description="Task title" 
           Grid.Row="3" />

        <!-- Row 4: Notes Label -->
        <Label Text="Description / notes (required)" 
           Style="{StaticResource WorkshopLabel}" 
           Grid.Row="4" />

        <!-- Row 5: Notes Editor -->
        <Editor x:Name="TaskNotesEditor" 
            Placeholder="Description / notes"
            Style="{StaticResource WorkshopEditor}" 
            HeightRequest="120"
            SemanticProperties.Description="Description or notes, required" 
            Grid.Row="5" />

        <!-- Row 6: Due Date Label -->
        <Label Text="Due date" 
           Style="{StaticResource WorkshopLabel}" 
           Grid.Row="6" />

        <!-- Row 7: DatePicker -->
        <DatePicker x:Name="DueDatePicker" 
                Format="MMM d, yyyy"
                TextColor="{StaticResource WorkshopInk}"
                BackgroundColor="{StaticResource WorkshopBackground}"
                SemanticProperties.Description="Due date" 
                Grid.Row="7" />

        <!-- Row 8: Task Type Label -->
        <Label Text="Task type" 
           Style="{StaticResource WorkshopLabel}" 
           Grid.Row="8" />

        <!-- Row 9: Task Type Picker -->
        <Picker x:Name="TaskTypePicker" 
            Title="Choose a task type"
            Style="{StaticResource WorkshopPicker}"
            Grid.Row="9" />

        <!-- Row 10: Repeat Label -->
        <Label Text="Repeat" 
           Style="{StaticResource WorkshopLabel}" 
           Grid.Row="10" />

        <!-- Row 11: Repeat Picker -->
        <Picker x:Name="RepeatPicker" 
            Title="Repeat schedule" 
            SelectedIndex="0"
            Style="{StaticResource WorkshopPicker}"
            Grid.Row="11" />

        <!-- Row 12: Action Buttons -->
        <FlexLayout Wrap="Wrap" 
                Margin="0,12,0,0" 
                Grid.Row="12">
          <Button Text="Save" 
                Style="{StaticResource WorkshopPrimaryButton}"
                IsEnabled="False" 
                Margin="0,0,10,8" />
          <Button Text="Cancel" 
                Style="{StaticResource WorkshopButton}"
                Clicked="OnCancelClicked" 
                Margin="0,0,0,8" />
        </FlexLayout>
      </Grid>
    </Border>
  </ScrollView>
</ContentPage>
