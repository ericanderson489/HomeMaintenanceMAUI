<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:HomeMaintenanceMAUI"
             x:Class="HomeMaintenanceMAUI.RenovationsView"
             BackgroundColor="{StaticResource WorkshopBackground}">
  <!-- This destination contains presentation-only text until renovation details are defined. -->
  <ScrollView>
    <VerticalStackLayout Padding="20,16" Spacing="20">
      <VerticalStackLayout Spacing="8" Margin="0,0,0,8">
        <Label Text="Renovations" Style="{StaticResource WorkshopPageHeading}" Margin="8,0" />
        <Label Text="Room for your next big project."
               Style="{StaticResource WorkshopSubtitle}" Margin="6,2,0,0" />
        <local:WorkshopRuler />
      </VerticalStackLayout>
      <Border Style="{StaticResource WorkshopCard}" Padding="24">
        <VerticalStackLayout Spacing="12">
          <Label Text="Renovation tracking is coming soon."
                 Style="{StaticResource WorkshopLabel}"
                 FontFamily="{StaticResource WorkshopHeadingFont}" FontAttributes="Bold"
                 FontSize="28" SemanticProperties.HeadingLevel="Level2" />
          <Label Text="Your renovation projects and details will appear here."
                 Style="{StaticResource WorkshopSubtitle}" />
        </VerticalStackLayout>
      </Border>
    </VerticalStackLayout>
  </ScrollView>
</ContentView>
