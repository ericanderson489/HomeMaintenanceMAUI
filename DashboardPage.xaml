<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:HomeMaintenanceMAUI"
             x:Class="HomeMaintenanceMAUI.DashboardPage"
             Title="Workshop" Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource WorkshopCanvas}">
  <!-- GUI theme bindings: the following original expressions were fixed light colors.
       BEFORE: BackgroundColor="{StaticResource WorkshopBackground}"
       AFTER:  BackgroundColor="{DynamicResource WorkshopCanvas}"
       These replacements update appearance only; task bindings and handlers are unchanged. -->
  <!-- BEFORE: This page had no theme behavior.
       AFTER: Our theme behavior follows the saved light/dark preference for native controls. -->
  <ContentPage.Behaviors>
    <local:WorkshopLightThemeBehavior />
  </ContentPage.Behaviors>
  <Grid x:Name="WorkspaceGrid" ColumnDefinitions="205,*" RowDefinitions="Auto,*">
    <!-- BEFORE: WorkspaceGrid had no Grid.Behaviors collection.
         AFTER: <Grid.Behaviors><local:WorkshopDashboardLayoutBehavior /></Grid.Behaviors>
         The new presentation-only behavior selects the states from measured content width. -->
    <Grid.Behaviors>
      <local:WorkshopDashboardLayoutBehavior />
    </Grid.Behaviors>
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="WindowWidth">
        <!-- BEFORE:
             <VisualState x:Name="Wide">
               <VisualState.StateTriggers>
                 <AdaptiveTrigger MinWindowWidth="800" />
               </VisualState.StateTriggers>
             </VisualState>
             AFTER:
             <VisualState x:Name="Wide">
               <VisualState.Setters>
                 <Setter Property="ColumnDefinitions" Value="205,*" />
                 <Setter TargetName="Sidebar" Property="IsVisible" Value="True" />
                 <Setter TargetName="CompactNavigation" Property="IsVisible" Value="False" />
               </VisualState.Setters>
             </VisualState>
             Explicit setters restore the desktop layout after widening the window. -->
        <VisualState x:Name="Wide">
          <VisualState.Setters>
            <Setter Property="ColumnDefinitions" Value="205,*" />
            <Setter TargetName="Sidebar" Property="IsVisible" Value="True" />
            <Setter TargetName="CompactNavigation" Property="IsVisible" Value="False" />
          </VisualState.Setters>
        </VisualState>
        <!-- BEFORE: Narrow contained this trigger block:
             <VisualState.StateTriggers>
               <AdaptiveTrigger MinWindowWidth="0" />
             </VisualState.StateTriggers>
             AFTER: That block is removed; WorkshopDashboardLayoutBehavior selects Narrow.
             The existing Narrow setters below are unchanged. -->
        <VisualState x:Name="Narrow">
          <VisualState.Setters>
            <Setter Property="ColumnDefinitions" Value="0,*" />
            <Setter TargetName="Sidebar" Property="IsVisible" Value="False" />
            <Setter TargetName="CompactNavigation" Property="IsVisible" Value="True" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <!-- Both navigation layouts use the same presentation-only event handlers. -->
    <Grid x:Name="Sidebar" Grid.RowSpan="2" Padding="12,12,20,16"
          RowDefinitions="155,50,50,50,*,50" RowSpacing="6"
          BackgroundColor="{StaticResource WorkshopNavy}">
      <local:WorkshopSign Margin="0,0,0,20" />
      <local:WorkshopNavigationButton x:Name="HomeButton" Grid.Row="1" Text="Home"
              Clicked="OnHomeClicked"
              Style="{StaticResource WorkshopNavigationButton}" />
      <local:WorkshopNavigationButton x:Name="TasksButton" Grid.Row="2" Text="Tasks"
              Clicked="OnTasksClicked"
              Style="{StaticResource WorkshopNavigationButton}" />
      <local:WorkshopNavigationButton x:Name="RenovationsButton" Grid.Row="3" Text="Renovations"
              Clicked="OnRenovationsClicked"
              Style="{StaticResource WorkshopNavigationButton}" />
      <!-- BEFORE: Row 4 was only unused flexible space.
           AFTER: The Settings action sits at its bottom without changing the existing rows. -->
      <local:WorkshopNavigationButton x:Name="SettingsButton" Grid.Row="4" Text="Settings"
              Clicked="OnSettingsClicked" VerticalOptions="End"
              HeightRequest="44" MinimumHeightRequest="44"
              Style="{StaticResource WorkshopNavigationButton}" />
      <Button Grid.Row="5" Text="Sign out" Clicked="OnSignOutClicked"
              HorizontalOptions="Start"
              Style="{StaticResource WorkshopNavigationButton}" />
    </Grid>
    <VerticalStackLayout x:Name="CompactNavigation" Grid.Column="1" IsVisible="False"
                         Padding="12" Spacing="10"
                         BackgroundColor="{StaticResource WorkshopNavy}">
      <!-- BEFORE:
           <Label Text="BREACHLESS BUNGALOW · WORKSHOP"
                  FontFamily="{StaticResource WorkshopHeadingFont}" FontAttributes="Bold"
                  TextColor="{StaticResource WorkshopGold}" FontSize="16" />
           AFTER: Keep that brand label inside a flexible column and add Settings beside it.
           This keeps the four existing compact-navigation actions in their same two rows. -->
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <Label Text="BREACHLESS BUNGALOW · WORKSHOP"
               FontFamily="{StaticResource WorkshopHeadingFont}" FontAttributes="Bold"
               TextColor="{StaticResource WorkshopGold}" FontSize="16"
               VerticalOptions="Center" LineBreakMode="WordWrap" />
        <Button x:Name="CompactSettingsButton" Grid.Column="1" Text="Settings"
                Clicked="OnSettingsClicked" Style="{StaticResource WorkshopNavigationButton}"
                FontSize="16" Padding="10,8" HeightRequest="44" MinimumHeightRequest="44" />
      </Grid>
      <!-- BEFORE:
           <FlexLayout Direction="Row" Wrap="Wrap">
             <Button x:Name="CompactHomeButton" Text="Home" Clicked="OnHomeClicked"
                     Margin="0,0,8,8" Style="{StaticResource WorkshopNavigationButton}" />
             <Button x:Name="CompactTasksButton" Text="Tasks" Clicked="OnTasksClicked"
                     Margin="0,0,8,8" Style="{StaticResource WorkshopNavigationButton}" />
             <Button x:Name="CompactRenovationsButton" Text="Renovations"
                     Clicked="OnRenovationsClicked" Margin="0,0,8,8"
                     Style="{StaticResource WorkshopNavigationButton}" />
             <Button Text="Sign out" Clicked="OnSignOutClicked" Margin="0,0,0,8"
                     Style="{StaticResource WorkshopNavigationButton}" />
           </FlexLayout>
           AFTER:
           <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
             <Button x:Name="CompactHomeButton" Text="Home" Clicked="OnHomeClicked"
                     Padding="12,10" Style="{StaticResource WorkshopNavigationButton}" />
             <Button x:Name="CompactTasksButton" Text="Tasks" Clicked="OnTasksClicked"
                     Grid.Column="1" Padding="12,10" Style="{StaticResource WorkshopNavigationButton}" />
             <Button x:Name="CompactRenovationsButton" Text="Renovations"
                     Clicked="OnRenovationsClicked" Grid.Row="1" Padding="12,10"
                     Style="{StaticResource WorkshopNavigationButton}" />
             <Button Text="Sign out" Clicked="OnSignOutClicked" Grid.Row="1" Grid.Column="1"
                     Padding="12,10"
                     Style="{StaticResource WorkshopNavigationButton}" />
           </Grid>
           The same four buttons fit in two rows without consuming a third navigation row. -->
      <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
        <Button x:Name="CompactHomeButton" Text="Home" Clicked="OnHomeClicked"
                Padding="12,10" Style="{StaticResource WorkshopNavigationButton}" />
        <Button x:Name="CompactTasksButton" Text="Tasks" Clicked="OnTasksClicked"
                Grid.Column="1" Padding="12,10" Style="{StaticResource WorkshopNavigationButton}" />
        <Button x:Name="CompactRenovationsButton" Text="Renovations"
                Clicked="OnRenovationsClicked" Grid.Row="1" Padding="12,10"
                Style="{StaticResource WorkshopNavigationButton}" />
        <Button Text="Sign out" Clicked="OnSignOutClicked" Grid.Row="1" Grid.Column="1"
                Padding="12,10"
                Style="{StaticResource WorkshopNavigationButton}" />
      </Grid>
    </VerticalStackLayout>
    <Grid Grid.Row="1" Grid.Column="1">
      <local:WorkshopHomeView x:Name="HomeView" ViewTasksRequested="OnTasksClicked" />
      <local:TasksView x:Name="TasksView" IsVisible="False" />
      <local:RenovationsView x:Name="RenovationsView" IsVisible="False" />
      <!-- BEFORE: No Settings destination existed. AFTER: Show our GUI-only settings view. -->
      <local:SettingsView x:Name="SettingsView" IsVisible="False" />
    </Grid>
  </Grid>
</ContentPage>
