<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HomeMaintenanceMAUI.TaskListView">
  <!-- The empty body fills the workspace; the message belongs in the footer. -->
  <Border BackgroundColor="{StaticResource WorkshopPaper}" StrokeThickness="0" Padding="8">
    <Border Style="{StaticResource WorkshopCard}" Padding="0">
      <Grid RowDefinitions="Auto,*,Auto" MinimumHeightRequest="180">
        <Grid ColumnDefinitions="*,156,130" Padding="10,7" ColumnSpacing="0" Margin="3,3,3,0"
              BackgroundColor="{StaticResource WorkshopSteel}">
          <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="TableWidth">
              <VisualState x:Name="Wide">
                <VisualState.StateTriggers>
                  <AdaptiveTrigger MinWindowWidth="600" />
                </VisualState.StateTriggers>
              </VisualState>
              <VisualState x:Name="Narrow">
                <VisualState.StateTriggers>
                  <AdaptiveTrigger MinWindowWidth="0" />
                </VisualState.StateTriggers>
                <VisualState.Setters>
                  <Setter Property="ColumnDefinitions" Value="*,90,80" />
                </VisualState.Setters>
              </VisualState>
            </VisualStateGroup>
          </VisualStateManager.VisualStateGroups>
          <Label Text="Task" Style="{StaticResource WorkshopLabel}" />
          <Label Grid.Column="1" Text="Due date" Style="{StaticResource WorkshopLabel}" />
          <Label Grid.Column="2" Text="Status" Style="{StaticResource WorkshopLabel}" />
        </Grid>
        <Grid Grid.Row="2" RowDefinitions="1,Auto">
          <BoxView Color="{StaticResource WorkshopSteel}" HeightRequest="1" />
          <FlexLayout Grid.Row="1" Padding="0,3,8,3" AlignItems="Center" Wrap="Wrap">
            <!-- This inactive action retains the source button's visible ochre label. -->
            <Button Text="View details" IsEnabled="False" Margin="0,0,12,0"
                    Style="{StaticResource WorkshopInactiveButton}" />
            <Label x:Name="EmptyMessageLabel"
                   Style="{StaticResource WorkshopLabel}" VerticalOptions="Center" />
          </FlexLayout>
        </Grid>
      </Grid>
    </Border>
  </Border>
</ContentView>
