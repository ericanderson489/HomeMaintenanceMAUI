<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HomeMaintenanceMAUI.TaskListView">
  <!-- This empty table preserves the Workshop layout without supplying or processing task data. -->
  <Border Style="{StaticResource WorkshopCard}" Padding="0">
    <Grid RowDefinitions="Auto,*,Auto" MinimumHeightRequest="320">
      <Grid ColumnDefinitions="*,110,85" Padding="12,10" ColumnSpacing="8"
            BackgroundColor="{StaticResource WorkshopSteel}">
        <Label Text="Task" Style="{StaticResource WorkshopLabel}" FontAttributes="Bold" />
        <Label Grid.Column="1" Text="Due date" Style="{StaticResource WorkshopLabel}"
               FontAttributes="Bold" />
        <Label Grid.Column="2" Text="Status" Style="{StaticResource WorkshopLabel}"
               FontAttributes="Bold" />
      </Grid>
      <Label Grid.Row="1" Text="No tasks yet. Add your first job."
             Style="{StaticResource WorkshopSubtitle}" Margin="20,28"
             HorizontalTextAlignment="Center" VerticalOptions="Center" />
      <Grid Grid.Row="2" RowDefinitions="1,Auto">
        <BoxView Color="{StaticResource WorkshopSteel}" HeightRequest="1" />
        <FlexLayout Grid.Row="1" Padding="12" AlignItems="Center" Wrap="Wrap">
          <!-- The team can connect task selection later; no task command is imported. -->
          <Button Text="View details" Style="{StaticResource WorkshopButton}"
                  IsEnabled="False" Margin="0,0,12,0" />
          <Label Text="No job selected" Style="{StaticResource WorkshopSubtitle}"
                 VerticalOptions="Center" />
        </FlexLayout>
      </Grid>
    </Grid>
  </Border>
</ContentView>
